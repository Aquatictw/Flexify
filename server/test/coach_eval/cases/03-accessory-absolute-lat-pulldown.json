{
  "name": "03-accessory-absolute-lat-pulldown",
  "description": "Protects user-stated absolute accessory weight without a unit field.",
  "snapshot_ref": "leader2-w2-kg",
  "utterance": "add 3×10 lat pulldown at 60kg",
  "expect": [
    {
      "tool": "apply_session_changes",
      "args_match": {
        "ops": {
          "$contains": [
            {
              "op": "add_exercise",
              "exercise": "Lat Pulldown",
              "sets": {
                "$len": 3,
                "$all": {
                  "weight_spec": {
                    "absolute": 60,
                    "pct_of_tm": {"$absent": true}
                  },
                  "reps": 10,
                  "unit": {"$absent": true}
                }
              }
            }
          ]
        }
      }
    }
  ]
}
