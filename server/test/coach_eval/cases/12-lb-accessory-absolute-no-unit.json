{
  "name": "12-lb-accessory-absolute-no-unit",
  "description": "Protects a unitless user-stated accessory weight in an lb snapshot.",
  "snapshot_ref": "leader1-w1-lb",
  "utterance": "add 3x10 barbell row at 135",
  "expect": [
    {
      "tool": "apply_session_changes",
      "args_match": {
        "ops": {
          "$contains": [
            {
              "op": "add_exercise",
              "exercise": "Barbell Row",
              "unit": {"$absent": true},
              "sets": {
                "$len": 3,
                "$all": {
                  "weight_spec": {"absolute": 135},
                  "reps": 10,
                  "unit": {"$absent": true}
                }
              }
            }
          ]
        }
      }
    }
  ]
}
